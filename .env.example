# WooCommerce REST API Kredencijali
# Kopiraj ovu datoteku kao .env i popuni stvarnim vrijednostima

# Autoritativna ciljna domena (Docker: https://dinamic.loc)
UPP_TARGET_DOMAIN=https://dinamic.hr

# WooCommerce Consumer Key
# Generiši na: WordPress Admin → WooCommerce → Settings → REST API → Gener Key/Secret
WOO_CONSUMER_KEY=ck_xxx

# WooCommerce Consumer Secret
WOO_CONSUMER_SECRET=cs_xxx

# Samo za lokalni razvoj sa self-signed certifikatom; u produkciji mora biti true
WOO_VERIFY_SSL=true

# Opciono: Log datoteka
# LOG_FILE=./upp_log.txt

# Opciono: JSON datoteka putanja
# JSON_FILE_PATH=./uploads/datoteka.json
