{
    "name": "upp/woocommerce-importer",
    "description": "Vanjska aplikacija za sinkronizaciju ERP proizvoda s WooCommerce REST API-jem v3",
    "license": "proprietary",
    "type": "project",
    "require": {
        "php": "^8.1",
        "ext-json": "*",
        "automattic/woocommerce": "^3.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "Upp\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Upp\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "scripts": {
        "test": "phpunit"
    }
}
